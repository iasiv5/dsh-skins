{
  "name": "@iasiv5/dsh-skins",
  "description": "Modular DSH Web skin pack with official fallback, OpenBMC and UEFI appearances, and verified stable-Release updates",
  "version": "1.0.4",
  "homepage": "https://github.com/iasiv5/dsh-skins#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iasiv5/dsh-skins.git"
  },
  "bugs": {
    "url": "https://github.com/iasiv5/dsh-skins/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "skin",
    "theme",
    "personalization",
    "openbmc",
    "uefi",
    "tgcf"
  ],
  "packageManager": "pnpm@10.34.5",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-theme",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-client-connection": "^0.1.1-rc.2 || ^0.1.2-rc.1",
    "@deepseek-ai/dsh-client-runtime": "^0.1.1-rc.2 || ^0.1.2-rc.1",
    "@deepseek-ai/dsh-client-ui-conversation": "^0.1.1-rc.2 || ^0.1.2-rc.1",
    "@deepseek-ai/dsh-client-ui-sidebar": "^0.1.1-rc.2 || ^0.1.2-rc.1",
    "@deepseek-ai/dsh-client-ui-theme": "^0.1.1-rc.2 || ^0.1.2-rc.1"
  },
  "license": "MIT",
  "scripts": {
    "build": "node scripts/build-client.mjs",
    "watch": "node scripts/build-client.mjs --watch",
    "test": "pnpm run build && node smoke-test.cjs && node --test tests/*.test.mjs",
    "verify:readme": "node scripts/verify-readme-pairing.mjs",
    "verify:bundle": "node scripts/verify-bundle-guard.mjs",
    "verify:hooks": "node scripts/verify-upstream-hooks.mjs",
    "check": "pnpm run build && node --check lib/client.js && node --check lib/index.js && pnpm run test && pnpm run verify:readme && pnpm run verify:bundle && pnpm run verify:hooks"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "esbuild": "^0.28.2",
    "playwright-core": "1.62.1"
  }
}
