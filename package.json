{
  "name": "@iasiv5/dsh-skins",
  "description": "DSH Web 皮肤插件：多套品牌皮肤侧栏热切换。",
  "icon": "./icon.svg",
  "version": "1.5.19",
  "homepage": "https://github.com/iasiv5/dsh-skins#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iasiv5/dsh-skins.git"
  },
  "bugs": {
    "url": "https://github.com/iasiv5/dsh-skins/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "skin",
    "theme",
    "personalization",
    "openbmc",
    "uefi"
  ],
  "packageManager": "pnpm@10.34.5",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "locale",
    "README.md",
    "README.en.md",
    "LICENSE",
    "icon.svg"
  ],
  "dsh": {
    "engines": {
      "dsh": ">=0.2.0-rc.1 || >=0.2.1-rc.1"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-theme",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-client-connection": ">=0.2.0-rc.1 || >=0.2.1-rc.1",
    "@deepseek-ai/dsh-client-locale": ">=0.2.0-rc.1 || >=0.2.1-rc.1",
    "@deepseek-ai/dsh-client-runtime": ">=0.2.0-rc.1 || >=0.2.1-rc.1",
    "@deepseek-ai/dsh-client-ui-conversation": ">=0.2.0-rc.1 || >=0.2.1-rc.1",
    "@deepseek-ai/dsh-client-ui-sidebar": ">=0.2.0-rc.1 || >=0.2.1-rc.1",
    "@deepseek-ai/dsh-client-ui-theme": ">=0.2.0-rc.1 || >=0.2.1-rc.1"
  },
  "license": "MIT",
  "scripts": {
    "build": "node scripts/build-client.mjs",
    "watch": "node scripts/build-client.mjs --watch",
    "check:lockfile": "pnpm install --frozen-lockfile",
    "test": "pnpm run build && node smoke-test.cjs && node scripts/repro-stale-grid-paint.mjs --gate && node --test tests/*.test.mjs",
    "verify:readme": "node scripts/verify-readme-pairing.mjs",
    "verify:bundle": "node scripts/verify-bundle-guard.mjs",
    "verify:hooks": "node scripts/verify-upstream-hooks.mjs",
    "check": "pnpm run check:lockfile && pnpm run build && node --check lib/client.js && node --check lib/index.js && pnpm run lint && pnpm run test && pnpm run verify:readme && pnpm run verify:bundle && pnpm run verify:hooks && git diff --exit-code -- lib/index.js lib/client.js",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "playwright-core": "1.62.1",
    "semver": "^7.8.5"
  }
}
